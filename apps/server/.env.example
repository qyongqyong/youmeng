# 后端环境变量示例
# 复制为 .env 使用：cp .env.example .env
# 注意：当前后端仍是骨架，以下变量尚未被代码实际使用（仅占位，供后续接入）

# 服务端口
PORT=3000

# 数据库（后续接入 PostgreSQL 时使用）
DATABASE_URL=postgresql://user:password@localhost:5432/youmeng

# 阿里云短信（M2 手机号验证码登录）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 通义万相 / DashScope（M3 生图）
DASHSCOPE_API_KEY=

# 可灵 Kling（M4 生视频）
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
