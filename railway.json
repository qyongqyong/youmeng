{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace @youmeng/api"
  },
  "deploy": {
    "startCommand": "npm run start --workspace @youmeng/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120
  }
}
