{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @youmeng/web build && pnpm --filter @youmeng/server build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @youmeng/server start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120
  }
}
